# Copy to .env for local development (or set these in the Railway dashboard).

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file is stored.
#   - Local dev: leave unset to default to ./transfers.db
#   - Railway:   /data/transfers.db (persistent volume mounted at /data)
DB_PATH=./transfers.db

# Port to listen on. Railway sets PORT automatically; 3000 is the local default.
PORT=3000

# development | production  (production enables secure session cookies)
NODE_ENV=development

# Admin panel login (/admin/login). Manage hotels, drivers and view transfers.
#   - Set these in the Railway dashboard for production.
#   - In development they default to admin / admin if left unset.
#   - If ADMIN_PASS is unset in production, admin login is disabled.
ADMIN_USER=admin
ADMIN_PASS=change-me-strong-admin-password
